BATCH_POLL_INTERVAL_SECONDS=3
MAX_DOCUMENT_PAGES=50
WORKER_POLL_SECONDS=5
WORKER_MAX_RETRIES=2
WORKER_RETRY_BACKOFF_SECONDS=2
WORKER_LEASE_SECONDS=900
